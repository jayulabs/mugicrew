# Graph tab (4) as the map: the fixture chains and the Chart still in fog.
Output "/out/graph-map.mp4"
Require mugicrew
Source /kit/settings.tape
Hide
Type "cd /tmp/demo && export PS1='$ ' && clear" Enter
Show
Type "mugicrew" Sleep 400ms Enter
Sleep 3s
Type "4" Sleep 4s
Type "j" Sleep 1s
Type "j" Sleep 1s
Type "j" Sleep 1s
Type "j" Sleep 1s
Type "j" Sleep 1s
Sleep 3s
Type "q" Sleep 500ms
